"use client";

import { useState, useRef, useEffect, useCallback } from "react";
import { recognizeCanvas, warmUpOcr } from "@/lib/ocr-engine-v2";
import { buildCameraPasses, buildUploadPasses, loadImageSource } from "@/lib/ocr-image";
import { resolveScanRawText } from "@/lib/scan-actions";
import { CardTile } from "@/components/CardTile";
import type { OwnedCounts } from "@/lib/collection-types";
import type { SwuCard } from "@/lib/swu-api";

export function ScanClient({ ownedMap }: { ownedMap: Record<string, OwnedCounts> }) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const [scanning, setScanning] = useState(false);
  const [statusText, setStatusText] = useState("");
  const [debugText, setDebugText] = useState("");
  const [foundCard, setFoundCard] = useState<{ card: SwuCard; owned: OwnedCounts } | null>(null);
  const [manualInput, setManualInput] = useState("");

  useEffect(() => {
    let stream: MediaStream | null = null;
    warmUpOcr();
    navigator.mediaDevices?.getUserMedia?.({
      video: {
        facingMode: "environment",
        width: { ideal: 1920 },
        height: { ideal: 1080 },
      },
    })
      .then((s) => {
        stream = s;
        if (videoRef.current) {
          videoRef.current.srcObject = s;
          videoRef.current.play();
        }
      })
      .catch(() => setStatusText("Kamera nicht verfügbar. Nutze Datei-Upload."));
    return () => {
      stream?.getTracks().forEach((t) => t.stop());
    };
  }, []);

  const handleScan = useCallback(async () => {
    if (!videoRef.current) return;
    setScanning(true);
    setDebugText("");
    setStatusText("Analysiere Bild...");
    try {
      const video = videoRef.current;
      const region = {
        x: video.videoWidth * 0.1,
        y: video.videoHeight * 0.7,
        width: video.videoWidth * 0.8,
        height: video.videoHeight * 0.25,
      };
      const passes = buildCameraPasses(video, region);

      let cardFound = false;
      for (const pass of passes) {
        const text = await recognizeCanvas(pass.canvas);
        setDebugText((prev) => `${prev}[${pass.label}] ${text.trim()}\n`);
        const res = await resolveScanRawText(text);
        if (res.success && res.card) {
          const key = `${res.card.Set}-${res.card.Number}`.toUpperCase();
          setFoundCard({ card: res.card, owned: ownedMap[key] || { normal: 0, foil: 0 } });
          cardFound = true;
          break;
        }
      }
      if (!cardFound) {
        setStatusText("Keine Karte erkannt. Versuche es erneut.");
      }
    } catch {
      setStatusText("Fehler beim Scannen.");
    } finally {
      setScanning(false);
    }
  }, [ownedMap]);

  async function handleFileUpload(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0];
    if (!file) return;
    setScanning(true);
    setDebugText("");
    setStatusText("Lese Foto...");
    try {
      const loaded = await loadImageSource(file);
      const passes = buildUploadPasses(loaded.source, loaded.width, loaded.height);
      loaded.dispose();

      let cardFound = false;
      for (const pass of passes) {
        const text = await recognizeCanvas(pass.canvas);
        setDebugText((prev) => `${prev}[${pass.label}] ${text.trim()}\n`);
        const res = await resolveScanRawText(text);
        if (res.success && res.card) {
          const key = `${res.card.Set}-${res.card.Number}`.toUpperCase();
          setFoundCard({ card: res.card, owned: ownedMap[key] || { normal: 0, foil: 0 } });
          cardFound = true;
          break;
        }
      }
      if (!cardFound) setStatusText("Karte im Foto nicht erkannt.");
    } catch {
      setStatusText("Fehler beim Verarbeiten des Fotos.");
    } finally {
      setScanning(false);
    }
  }

  async function handleManualSubmit(e: React.FormEvent) {
    e.preventDefault();
    if (!manualInput.trim()) return;
    setScanning(true);
    const res = await resolveScanRawText(manualInput);
    setScanning(false);
    if (res.success && res.card) {
      const key = `${res.card.Set}-${res.card.Number}`.toUpperCase();
      setFoundCard({ card: res.card, owned: ownedMap[key] || { normal: 0, foil: 0 } });
      setStatusText("");
    } else {
      setStatusText("Karte nicht gefunden.");
    }
  }

  return (
    <div className="space-y-4">
      <div className="relative aspect-[4/3] w-full overflow-hidden rounded-xl bg-black">
        <video ref={videoRef} playsInline muted className="h-full w-full object-cover" />
        <div className="absolute inset-x-8 bottom-8 h-20 rounded-lg border-2 border-dashed border-white/70 pointer-events-none flex items-center justify-center">
          <span className="text-xs text-white/80 bg-black/50 px-2 py-1 rounded">Fußzeile hier ausrichten</span>
        </div>
      </div>

      <div className="flex gap-2">
        <button
          type="button"
          onClick={handleScan}
          disabled={scanning}
          className="flex-1 rounded-lg bg-zinc-900 py-3 text-white font-medium hover:bg-zinc-700 disabled:opacity-50 dark:bg-zinc-100 dark:text-zinc-900"
        >
          {scanning ? "Scan läuft..." : "Karte scannen"}
        </button>
        <label className="flex-1 cursor-pointer rounded-lg border border-zinc-300 py-3 text-center font-medium hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-900">
          Foto hochladen
          <input type="file" accept="image/*" onChange={handleFileUpload} className="hidden" />
        </label>
      </div>

      <form onSubmit={handleManualSubmit} className="flex gap-2">
        <input
          type="text"
          placeholder="Manuell, z.B. SOR 10"
          value={manualInput}
          onChange={(e) => setManualInput(e.target.value)}
          className="flex-1 rounded-lg border border-zinc-300 px-3 py-2 text-sm dark:border-zinc-700 dark:bg-zinc-900"
        />
        <button type="submit" className="rounded-lg bg-zinc-800 px-4 py-2 text-sm text-white dark:bg-zinc-200 dark:text-zinc-900">
          Suchen
        </button>
      </form>

      {statusText && <p className="text-sm text-zinc-600 dark:text-zinc-400">{statusText}</p>}

      {debugText && (
        <pre className="whitespace-pre-wrap text-xs text-zinc-500">{debugText}</pre>
      )}

      {foundCard && (
        <div className="mt-6 border-t pt-4">
          <h3 className="mb-2 text-sm font-semibold">Gefundene Karte:</h3>
          <CardTile card={foundCard.card} owned={foundCard.owned} />
        </div>
      )}
    </div>
  );
}
</file>

<file path="lib/swu-api.ts">
/** Wrapper für die SWU-DB API (https://www.swu-db.com/api)
 * Endpunkte:
 *   GET /cards/{set}/{number}   -> einzelne Karte (Objekt)
 *   GET /cards/{set}            -> alle Karten eines Sets
 *   GET /cards/search?q=...     -> { total_cards, data: Card[] }
 *   GET /sets                   -> Set-Liste
 */
const BASE_URL = (
  process.env.NEXT_PUBLIC_SWU_API_BASE ?? "https://api.swu-db.com"
).replace(/\/+$/, "");

const REQUEST_TIMEOUT_MS = 10_000;

// ---------------------------------------------------------------------------
// Typen (Felder wie von der API geliefert; viele sind optional)
// ---------------------------------------------------------------------------

export interface SwuCard {
  Set: string; // "SOR"
  Number: string; // "010" oder "82" – NICHT einheitlich gepaddet
  Name: string;
  Subtitle?: string;
  Type: string; // Leader, Unit, Event, Upgrade, Base, ...
  Aspects: string[];
  Traits: string[];
  Arenas?: string[];
  Cost?: string;
  Power?: string;
  HP?: string;
  FrontText?: string;
  BackText?: string;
  EpicAction?: string;
  DoubleSided: boolean;
  Rarity: string;
  Unique: boolean;
  Keywords?: string[];
  Artist?: string;
  VariantType: string; // "Normal", ...
  MarketPrice?: string;
  FoilPrice?: string;
  LowPrice?: string;
  LowFoilPrice?: string;
  FrontArt: string; // https://cdn.swu-db.com/images/cards/SOR/010.png
  BackArt?: string;
  cid?: string;
  tcgplayerId?: string;
}

export interface SwuSet {
  setId: string;
  fullName: string;
  numberCards: number;
  maxElement: string;
  releaseDate: string;
}

interface SearchResponse {
  total_cards: number;
  data: SwuCard[];
}

export class SwuApiError extends Error {
  constructor(
    message: string,
    public readonly status?: number
  ) {
    super(message);
    this.name = "SwuApiError";
  }
}

// ---------------------------------------------------------------------------
// HTTP-Basis
// ---------------------------------------------------------------------------

/** Liefert null bei 404 (nicht gefunden / keine Treffer), wirft sonst bei Fehlern. */
async function request<T>(
  path: string,
  params?: Record<string, string>,
  revalidateSeconds = 3600
): Promise<T | null> {
  const qs = params ? `?${new URLSearchParams(params).toString()}` : "";
  let res: Response;
  try {
    res = await fetch(`${BASE_URL}${path}${qs}`, {
      headers: { Accept: "application/json" },
      signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
      next: { revalidate: revalidateSeconds },
    });
  } catch {
    throw new SwuApiError("SWU-DB ist nicht erreichbar.");
  }

  if (res.status === 404) return null;
  if (!res.ok) {
    throw new SwuApiError(`SWU-DB Fehler (HTTP ${res.status}).`, res.status);
  }

  try {
    return (await res.json()) as T;
  } catch {
    throw new SwuApiError("Ungültige Antwort der SWU-DB.", res.status);
  }
}

function extractCards(payload: SearchResponse | SwuCard[] | null): SwuCard[] {
  if (!payload) return [];
  return Array.isArray(payload) ? payload : (payload.data ?? []);
}

// ---------------------------------------------------------------------------
// API-Funktionen
// ---------------------------------------------------------------------------

/** Einzelne Karte per Set + Nummer. "sor"/"SOR" und "10"/"010" funktionieren. */
export async function getCard(
  set: string,
  number: string
): Promise<SwuCard | null> {
  return request<SwuCard>(
    `/cards/${encodeURIComponent(set.toLowerCase())}/${encodeURIComponent(number)}`
  );
}

/** Alle Basis-Karten eines Sets. */
export async function getSetCards(set: string): Promise<SwuCard[]> {
  const payload = await request<SearchResponse | SwuCard[]>(
    `/cards/${encodeURIComponent(set.toLowerCase())}`,
    { order: "setnumber" },
    86_400
  );
  return extractCards(payload);
}

/** Freitext-/Syntax-Suche (https://www.swu-db.com/syntax). Bare Words suchen im Namen. */
export async function searchCards(query: string): Promise<SwuCard[]> {
  const q = query.trim();
  if (!q) return [];
  const payload = await request<SearchResponse>("/cards/search", {
    q,
    order: "name",
  });
  return extractCards(payload);
}

/** Nur die offiziellen Star Wars: Unlimited Haupt-Sets erlauben. */
export async function getSets(): Promise<SwuSet[]> {
  const payload = await request<SwuSet[]>("/sets", undefined, 86_400);
  if (!payload) return [];

  const officialMainSets = [
    "SOR", // Spark of Rebellion
    "SHD", // Shadows of the Galaxy
    "TWI", // Twilight of the Republic
    "JTL", // Jump To Lightspeed
    "LOF", // Legends of the Force
    "LAW", // A Lawless Time
    "SEC", // Secrets of Power
    "ASH", // Ashes of the Empire
    "HMW", // Homeworlds
    "IBH", // Intro Battle: Hoth
    "TS26", // Twin Suns 2026
  ];

  return payload.filter((set) => officialMainSets.includes(set.setId.toUpperCase()));
}

// ---------------------------------------------------------------------------
// Sucheingabe: "sor 10", "SOR-010", "sor/10" -> Direktabruf, sonst Namens-/Syntaxsuche
// ---------------------------------------------------------------------------

const CARD_REF = /^([a-z][a-z0-9]{1,4})\s*[-/#\s]\s*(\d{1,3})$/i;

export function parseCardReference(
  input: string
): { set: string; number: string } | null {
  const m = CARD_REF.exec(input.trim());
  return m ? { set: m[1], number: m[2] } : null;
}

/** Zentrale Suchfunktion für die Suchleiste. */
export async function searchByInput(input: string): Promise<SwuCard[]> {
  const trimmed = input.trim();
  if (!trimmed) return [];

  const ref = parseCardReference(trimmed);
  if (ref) {
    const card = await getCard(ref.set, ref.number);
    if (card) return [card];
  }

  return searchCards(trimmed);
}

// ---------------------------------------------------------------------------
// Helfer
// ---------------------------------------------------------------------------

export function cardKey(set: string, number: string): string {
  return `${set.toUpperCase()}-${number.replace(/^0+(?=\d)/, "")}`;
}

export function cardTitle(card: Pick<SwuCard, "Name" | "Subtitle">): string {
  return card.Subtitle ? `${card.Name} – ${card.Subtitle}` : card.Name;
}

export function cardImageUrl(
  set: string,
  number: string,
  face: "front" | "back" = "front"
): string {
  const base = `${BASE_URL}/cards/${encodeURIComponent(set.toLowerCase())}/${encodeURIComponent(number)}?format=image`;
  return face === "back" ? `${base}&face=back` : base;
}
